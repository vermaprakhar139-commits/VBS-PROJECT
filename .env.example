# Common
NODE_ENV=development

# Backend
BACKEND_PORT=4000
MONGO_URI=mongodb://mongo:27017/vbs
JWT_ACCESS_SECRET=your_access_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Email (Nodemailer SMTP example)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Virtual Bus Services <no-reply@vbs.local>"

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional: Twilio (if you want real SMS; otherwise mock only)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_FROM_NUMBER=+1000000000

# Admin seed user
SEED_ADMIN_EMAIL=admin@vbs.local
SEED_ADMIN_PASSWORD=Admin@123

# Demo user
SEED_USER_EMAIL=user@vbs.local
SEED_USER_PASSWORD=User@123